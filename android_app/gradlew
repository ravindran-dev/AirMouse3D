#!/bin/sh

#
# Gradle start up script for POSIX generated by Gradle.
#
# Standard wrapper launcher script. If gradle/wrapper/gradle-wrapper.jar is
# missing (it is a binary file and is not generated by this text-only
# project export), open this project in Android Studio once and it will
# regenerate the wrapper jar automatically, or run `gradle wrapper` with any
# local Gradle 8.x install.
##############################################################################

APP_HOME=$(cd "$(dirname "$0")" >/dev/null && pwd)

JAVACMD="java"
if [ -n "$JAVA_HOME" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
fi

CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

exec "$JAVACMD" -Dorg.gradle.appname="$(basename "$0")" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
